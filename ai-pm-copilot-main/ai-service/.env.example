# Gemini API Key (Required for reasoning & Ask Copilot)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector DB Service Configuration (Optional)
# If left empty, the service will fall back to local disk-based embedded storage.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_optional_remote_qdrant_api_key
